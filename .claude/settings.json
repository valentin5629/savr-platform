{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "racine=$(git rev-parse --show-toplevel 2>/dev/null) && cd \"$racine\"; bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-hygiene.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "racine=$(git rev-parse --show-toplevel 2>/dev/null) && cd \"$racine\"; bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "racine=$(git rev-parse --show-toplevel 2>/dev/null) && cd \"$racine\"; bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-brief.sh",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "racine=$(git rev-parse --show-toplevel 2>/dev/null) && cd \"$racine\"; bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/db-guard.sh",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "racine=$(git rev-parse --show-toplevel 2>/dev/null) && cd \"$racine\"; bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-destructive.sh",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "racine=$(git rev-parse --show-toplevel 2>/dev/null) && cd \"$racine\"; bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-gate.sh"
          },
          {
            "type": "command",
            "command": "racine=$(git rev-parse --show-toplevel 2>/dev/null) && cd \"$racine\"; bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-pr.sh",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "racine=$(git rev-parse --show-toplevel 2>/dev/null) && cd \"$racine\"; bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-merge.sh"
          }
        ]
      }
    ]
  }
}
